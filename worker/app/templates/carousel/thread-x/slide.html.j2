<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>thread-x slide {{ index }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: {{ theme.bg }};
    --fg: #0F1419;
    --muted: #536471;
    --accent: #E0245E;
    --verified: #1D9BF0;
    --card: #ffffff;
    --card-border: #E5E7EB;
    --bullet: #0F1419;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1350px;
    background: var(--bg);
    color: var(--fg);
    font-family: 'IBM Plex Sans Thai', 'IBM Plex Sans', -apple-system, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  /* ===== Background ===== */
  .canvas {
    width: 1080px; height: 1350px;
    position: relative;
    overflow: hidden;
    {% if background_image %}
    background: url('{{ background_image }}') center/cover no-repeat;
    {% elif background_color %}
    background: {{ background_color }};
    {% else %}
    background: #F4EFE6;
    {% endif %}
  }
  {% if background_image %}
  /* Subtle dim only when photo is used (helps card pop) */
  .canvas::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.04) 0%, rgba(0,0,0,0.14) 100%);
    pointer-events: none;
  }
  {% endif %}

  /* ===== Tweet card ===== */
  .card {
    position: absolute;
    left: 64px;
    right: 64px;
    top: 50%;
    transform: translateY(-50%);
    background: var(--card);
    border-radius: 28px;
    padding: 56px 56px 64px 56px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.18), 0 8px 24px rgba(0, 0, 0, 0.10);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  /* ===== Profile row ===== */
  .profile {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 36px;
  }
  .avatar {
    width: 72px; height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2a2a2a, #555);
    flex-shrink: 0;
    overflow: hidden;
    {% if profile_image %}
    background: url('{{ profile_image }}') center/cover;
    {% endif %}
    display: flex; align-items: center; justify-content: center;
    color: white;
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 700;
    font-size: 28px;
  }
  .name-block { display: flex; flex-direction: column; gap: 2px; }
  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--fg);
    font-family: 'IBM Plex Sans', 'IBM Plex Sans Thai', sans-serif;
  }
  .verified {
    width: 24px; height: 24px;
    flex-shrink: 0;
  }
  .handle {
    font-size: 22px;
    color: var(--muted);
    font-family: 'IBM Plex Sans', sans-serif;
  }

  /* ===== Body ===== */
  .body {
    font-size: 34px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--fg);
    word-break: break-word;
  }
  .body p { margin-bottom: 22px; }
  .body p:last-child { margin-bottom: 0; }
  .body strong { font-weight: 700; }
  .body em {
    font-style: normal;
    color: var(--accent);
    font-weight: 600;
  }

  /* ===== Hook variant — biggest font on first slide ===== */
  .body.hook {
    font-size: 58px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.5px;
  }
  .body.hook p { margin-bottom: 28px; }
  .body.hook strong { font-weight: 800; }
  .body .quote {
    display: block;
    margin: 24px 0;
    padding-left: 24px;
    border-left: 4px solid var(--accent);
    font-weight: 500;
    color: var(--fg);
  }

  /* ===== Bullets ===== */
  .bullets {
    margin-top: 20px;
    list-style: none;
    padding: 0;
  }
  .bullets li {
    position: relative;
    padding-left: 32px;
    margin-bottom: 14px;
    font-size: 32px;
    line-height: 1.45;
  }
  .bullets li:last-child { margin-bottom: 0; }
  .bullets li::before {
    content: '•';
    position: absolute;
    left: 6px;
    top: 0;
    font-weight: 700;
    color: var(--bullet);
  }

  /* ===== Read more CTA ===== */
  .read-more {
    position: absolute;
    bottom: 28px;
    right: 36px;
    font-size: 22px;
    font-weight: 600;
    color: var(--accent);
    font-family: 'IBM Plex Sans', 'IBM Plex Sans Thai', sans-serif;
  }
  .read-more::after { content: ' →'; }

  /* ===== Last slide CTA variant ===== */
  .card.cta { padding-bottom: 80px; }
  .cta-action {
    display: inline-block;
    margin-top: 16px;
    background: var(--fg);
    color: white;
    padding: 16px 32px;
    border-radius: 999px;
    font-size: 26px;
    font-weight: 600;
    font-family: 'IBM Plex Sans', 'IBM Plex Sans Thai', sans-serif;
  }
</style>
</head>
<body>
<div class="canvas">

  <div class="card{% if slide.is_last %} cta{% endif %}">

    <div class="profile">
      <div class="avatar">{% if not profile_image %}{{ profile_initial|default('E') }}{% endif %}</div>
      <div class="name-block">
        <div class="name">
          {{ profile_name|default('Earth Rati') }}
          <svg class="verified" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path fill="#1D9BF0" d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"/>
          </svg>
        </div>
        <div class="handle">{{ profile_handle|default('@earth.rati') }}</div>
      </div>
    </div>

    <div class="body{% if slide.is_hook %} hook{% endif %}">
      {% if slide.body_html %}
        {{ slide.body_html|safe }}
      {% else %}
        {% for paragraph in slide.body.split('\n\n') %}
          <p>{{ paragraph|replace('\n', '<br>')|safe }}</p>
        {% endfor %}
      {% endif %}

      {% if slide.bullets %}
      <ul class="bullets">
        {% for b in slide.bullets %}
          <li>{{ b|safe }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if slide.cta_action %}
        <div class="cta-action">{{ slide.cta_action }}</div>
      {% endif %}
    </div>

    {% if not slide.is_last %}
      <div class="read-more">อ่านต่อ</div>
    {% endif %}

  </div>

</div>
</body>
</html>
