<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>{{ slide.type }} - {{ index }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: {{ theme.bg }};
    --fg: {{ theme.fg }};
    --muted: {{ theme.muted }};
    --accent: {{ theme.accent }};
    --border: {{ theme.border }};
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1350px;
    background: var(--bg);
    color: var(--fg);
    font-family: 'IBM Plex Sans Thai', 'IBM Plex Sans', -apple-system, system-ui, sans-serif;
    font-feature-settings: "ss01" on;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  .slide {
    width: 1080px; height: 1350px;
    padding: 96px 88px;
    display: flex; flex-direction: column;
    position: relative;
  }

  /* ===== Header ===== */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 56px;
  }
  .logo {
    display: flex; align-items: center; gap: 14px;
    color: var(--fg);
  }
  .logo-mark {
    width: 36px; height: 36px;
    border: 2px solid var(--fg);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 22px;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .logo-text {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.3px;
  }
  .logo-text span { font-weight: 300; opacity: 0.55; }
  .badge {
    background: var(--accent);
    color: #fff;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  /* ===== Content area ===== */
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ===== Cover ===== */
  .cover-eyebrow {
    font-size: 24px;
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 32px;
  }
  .cover-title {
    font-size: 88px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -1.5px;
    margin-bottom: 36px;
  }
  .cover-title .accent { color: var(--accent); }
  .cover-subtitle {
    font-size: 36px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--muted);
    max-width: 880px;
  }

  /* ===== Content slide ===== */
  .content-eyebrow {
    font-size: 22px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 24px;
  }
  .content-headline {
    font-size: 64px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.8px;
    margin-bottom: 36px;
  }
  .content-body {
    font-size: 34px;
    font-weight: 400;
    line-height: 1.45;
    color: var(--fg);
    max-width: 880px;
  }
  .content-body strong {
    background: linear-gradient(transparent 60%, {{ theme.accent }}33 60%);
    font-weight: 500;
  }

  /* ===== Quote ===== */
  .quote {
    font-size: 64px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.6px;
    text-align: left;
  }
  .quote::before {
    content: '"';
    display: block;
    font-size: 200px;
    color: var(--accent);
    line-height: 0.7;
    margin-bottom: 32px;
    font-family: 'IBM Plex Sans', serif;
  }
  .quote-author {
    margin-top: 36px;
    font-size: 26px;
    color: var(--muted);
    font-weight: 500;
  }

  /* ===== Stat ===== */
  .stat-number {
    font-size: 240px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -6px;
    color: var(--accent);
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .stat-label {
    font-size: 44px;
    font-weight: 600;
    margin-top: 24px;
    line-height: 1.2;
  }
  .stat-context {
    font-size: 26px;
    color: var(--muted);
    margin-top: 20px;
    line-height: 1.5;
    max-width: 800px;
  }

  /* ===== List ===== */
  .list-headline {
    font-size: 56px;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 48px;
    letter-spacing: -0.6px;
  }
  .list-items { display: flex; flex-direction: column; gap: 28px; }
  .list-item {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    font-size: 30px;
    line-height: 1.4;
  }
  .list-num {
    flex-shrink: 0;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    font-size: 22px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'IBM Plex Sans', sans-serif;
  }

  /* ===== CTA ===== */
  .cta-eyebrow {
    font-size: 26px;
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 28px;
  }
  .cta-headline {
    font-size: 76px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1px;
    margin-bottom: 32px;
  }
  .cta-body {
    font-size: 34px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--fg);
    margin-bottom: 60px;
    max-width: 880px;
  }
  .cta-handle {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: var(--fg);
    color: var(--bg);
    padding: 22px 40px;
    border-radius: 999px;
    font-size: 28px;
    font-weight: 600;
    font-family: 'IBM Plex Sans', sans-serif;
  }

  /* ===== Footer ===== */
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    font-size: 20px;
    color: var(--muted);
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .footer-handle { font-weight: 500; }
  .footer-page { font-weight: 600; }
  .footer-swipe::after {
    content: ' →';
    color: var(--accent);
  }

  /* ===== Cover-specific decoration ===== */
  .cover-deco {
    position: absolute;
    bottom: -80px;
    right: -80px;
    width: 360px; height: 360px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.08;
    z-index: 0;
  }
  .cover-deco-2 {
    position: absolute;
    top: 240px;
    right: -120px;
    width: 200px; height: 200px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.06;
    z-index: 0;
  }
</style>
</head>
<body>

{% set t = slide.type %}

<div class="slide">

  {# ===== HEADER (skip for cover with badge variant) ===== #}
  {% if t != 'cover' or not slide.badge %}
  <div class="header">
    <div class="logo">
      <div class="logo-mark">O</div>
      <div class="logo-text">Outlier <span>Agency</span></div>
    </div>
    {% if t == 'cover' and slide.badge %}
      <div class="badge">{{ slide.badge }}</div>
    {% endif %}
  </div>
  {% else %}
  <div class="header">
    <div class="logo">
      <div class="logo-mark">O</div>
      <div class="logo-text">Outlier <span>Agency</span></div>
    </div>
    <div class="badge">{{ slide.badge }}</div>
  </div>
  {% endif %}

  {# ===== BODY ===== #}
  <div class="body" style="z-index: 1;">

    {% if t == 'cover' %}
      {% if slide.eyebrow %}<div class="cover-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
      <h1 class="cover-title">{{ slide.title|safe }}</h1>
      {% if slide.subtitle %}<p class="cover-subtitle">{{ slide.subtitle }}</p>{% endif %}

    {% elif t == 'content' %}
      {% if slide.eyebrow %}<div class="content-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
      <h2 class="content-headline">{{ slide.headline|safe }}</h2>
      {% if slide.body %}<p class="content-body">{{ slide.body|safe }}</p>{% endif %}

    {% elif t == 'quote' %}
      <div class="quote">{{ slide.text }}</div>
      {% if slide.author %}<div class="quote-author">— {{ slide.author }}</div>{% endif %}

    {% elif t == 'stat' %}
      <div class="stat-number">{{ slide.number }}</div>
      <div class="stat-label">{{ slide.label }}</div>
      {% if slide.context %}<div class="stat-context">{{ slide.context }}</div>{% endif %}

    {% elif t == 'list' %}
      <h2 class="list-headline">{{ slide.headline|safe }}</h2>
      <div class="list-items">
        {% for item in slide['items'] %}
          <div class="list-item">
            <div class="list-num">{{ loop.index }}</div>
            <div>{{ item|safe }}</div>
          </div>
        {% endfor %}
      </div>

    {% elif t == 'cta' %}
      <div class="cta-eyebrow">Next Step</div>
      <h2 class="cta-headline">{{ slide.headline|safe }}</h2>
      {% if slide.body %}<p class="cta-body">{{ slide.body|safe }}</p>{% endif %}
      {% if slide.handle %}<div class="cta-handle">{{ slide.handle }}</div>{% endif %}

    {% endif %}
  </div>

  {# ===== FOOTER ===== #}
  {% if t != 'cover' and t != 'cta' %}
  <div class="footer">
    <div class="footer-handle">@earth.rati</div>
    {% if slide.footer %}<div class="footer-page">{{ slide.footer }}</div>{% endif %}
  </div>
  {% elif t == 'cover' %}
  <div class="footer">
    <div class="footer-handle">@earth.rati</div>
    <div class="footer-swipe">เลื่อนดู</div>
  </div>
  <div class="cover-deco"></div>
  <div class="cover-deco-2"></div>
  {% endif %}

</div>

</body>
</html>
