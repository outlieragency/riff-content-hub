<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>fb-content cover — minimal-portrait</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;700;800;900&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Sarabun:wght@500;700;800&family=Anuphan:wght@400;500;700&family=Bai+Jamjuree:wght@400;500;700&family=Krub:wght@400;500;700&family=Mitr:wght@400;500;700&family=Prompt:wght@400;500;700;800&family=Pridi:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: {{ theme.bg if theme and theme.bg else "#0F0F10" }};
    --fg: {{ theme.fg if theme and theme.fg else "#FFFFFF" }};
    --hl-red: {{ theme.hl_red if theme and theme.hl_red else "#FF6B1A" }};
    --hl-yellow: {{ theme.hl_yellow if theme and theme.hl_yellow else "#FFD400" }};
    --hl-orange: {{ theme.hl_orange if theme and theme.hl_orange else "#FF6B1A" }};
    --font-heading: '{{ fonts.heading if fonts and fonts.heading else "Noto Sans Thai" }}';
    --font-body: '{{ fonts.body if fonts and fonts.body else "Noto Sans Thai" }}';
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1350px;
    background: var(--bg);
    font-family: var(--font-body), 'Noto Sans Thai', 'IBM Plex Sans Thai', sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow: hidden;
    color: var(--fg);
  }
  .canvas {
    width: 1080px; height: 1350px;
    position: relative;
    overflow: hidden;
  }

  /* Photo fills 70% top, gradient seamlessly into bottom panel */
  .photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-position: center 35%;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.20) 0%, rgba(0,0,0,0) 30%, rgba(0,0,0,0) 50%, rgba(0,0,0,0.65) 78%, var(--bg) 95%);
  }

  /* Brand mark — top-right small */
  .brand-mark {
    position: absolute;
    top: 36px; right: 36px;
    width: 88px; height: 88px;
    z-index: 5;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-mark img { width: 100%; height: 100%; object-fit: contain; }

  /* Eyebrow — small caps above headline */
  .eyebrow {
    position: absolute;
    left: 70px; right: 70px;
    bottom: 470px;
    z-index: 4;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 18px;
    font-weight: 600;
    color: var(--hl-orange);
    font-family: var(--font-body), sans-serif;
  }

  /* Headline block — bottom 35% */
  .headline {
    position: absolute;
    left: 70px; right: 70px;
    bottom: 130px;
    z-index: 4;
    font-family: var(--font-heading), 'Noto Sans Thai', sans-serif;
    color: var(--fg);
  }
  .line {
    font-weight: 800;
    font-size: 76px;
    line-height: 1.18;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
  }
  .line .hl-red    { color: var(--hl-red); }
  .line .hl-yellow { color: var(--hl-yellow); }
  .line .hl-orange { color: var(--hl-orange); }
  .line .hl-bg-red    { background: var(--hl-red); padding: 0 10px; border-radius: 6px; color: #FFF; }
  .line .hl-bg-yellow { background: var(--hl-yellow); padding: 0 10px; border-radius: 6px; color: #000; }
  .line .hl-bg-orange { background: var(--hl-orange); padding: 0 10px; border-radius: 6px; color: #000; }

  /* Subhead — italic, smaller, muted */
  .subhead {
    margin-top: 14px;
    font-family: var(--font-body), sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: 26px;
    color: rgba(255,255,255,0.78);
    line-height: 1.35;
  }

  /* Bottom branding strip */
  .footer-strip {
    position: absolute;
    left: 70px; right: 70px;
    bottom: 50px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 18px;
    color: rgba(255,255,255,0.55);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .footer-strip .channel {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .footer-strip .avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255,255,255,0.08);
  }
  .footer-strip .avatar img { width: 100%; height: 100%; object-fit: cover; }
</style>
</head>
<body>
<div class="canvas">
  {% if screenshot_data_uri %}
  <div class="photo" style="background-image:url('{{ screenshot_data_uri }}');"></div>
  {% else %}
  <div class="photo" style="background:#1a1a1a;"></div>
  {% endif %}

  {% if brand_mark_data_uri %}
  <div class="brand-mark"><img src="{{ brand_mark_data_uri }}" alt=""></div>
  {% endif %}

  <div class="eyebrow">{{ subhead or "Riff" }}</div>

  <div class="headline">
    <div class="line" {{ line1_style_attr|default('', true)|safe }}>{{ line1_html|safe }}</div>
    <div class="line" {{ line2_style_attr|default('', true)|safe }}>{{ line2_html|safe }}</div>
    <div class="line" {{ line3_style_attr|default('', true)|safe }}>{{ line3_html|safe }}</div>
  </div>

  <div class="footer-strip">
    <div class="channel">
      {% if channel_avatar_data_uri %}
      <span class="avatar"><img src="{{ channel_avatar_data_uri }}" alt=""></span>
      {% endif %}
      <span>{{ channel_name }}</span>
    </div>
    {% if subscriber_text_en %}
    <div>{{ subscriber_text_en }}</div>
    {% endif %}
  </div>
</div>
</body>
</html>
