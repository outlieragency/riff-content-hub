# =====================================================================
# Riff Worker — environment variables
# Copy this file → .env (worker/.env), fill in values
# =====================================================================

# Anthropic Claude API (required)
ANTHROPIC_API_KEY=sk-ant-...

# YouTube Data API v3 (required, get from Google Cloud Console)
YOUTUBE_API_KEY=AIzaSy...

# Supabase (service role — bypasses RLS, server-side only, NEVER expose to client)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Shared secret with portal (HMAC auth between services)
# Generate: openssl rand -hex 32
WORKER_SECRET=change-me-to-random-32-byte-hex

# Models
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5

# === Notion (optional — enables /notion/push button) ==================
# Get token: https://www.notion.so/my-integrations
# DSID = data_source_id (the long uuid in your DB URL after /v/)
NOTION_TOKEN=
NOTION_CONTENT_HUB_DSID=
NOTION_OUTPUT_TRACKER_DSID=

# === Webshare proxy (REQUIRED on cloud — Railway/Vercel/AWS) ===========
# YouTube blocks transcript scraping from datacenter IPs. Webshare
# residential proxies bypass the block. Sign up at webshare.io and
# pick a residential plan (~$5/mo).
# Skip if running the worker on a residential IP (e.g. local Mac).
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Generic HTTP proxy fallback (only if not using Webshare)
TRANSCRIPT_HTTP_PROXY_URL=
TRANSCRIPT_HTTPS_PROXY_URL=

# === Server config ====================================================
PORT=8000
LOG_LEVEL=info
