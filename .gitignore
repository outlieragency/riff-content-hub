# ========== Root .gitignore for riff-content-hub monorepo ==========

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Env (NEVER commit secrets)
.env
.env.local
.env.production
.env.*.local
*.env
!*.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific generated
.DS_Store

# ========== Node (portal/) ==========
node_modules/
.next/
out/
build/
dist/
coverage/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ========== Python (worker/) ==========
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv
.uv/

# ========== Supabase ==========
supabase/.branches/
supabase/.temp/

# ========== Test artifacts ==========
/tmp/
*.smoke.png
.coverage
htmlcov/

# ========== Local-only dev assets ==========
worker/app/assets/_local/
